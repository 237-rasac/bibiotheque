    "/api/reservations": {
      "get": {
        "tags": [
          "Reservation"
        ],
        "summary": "Lister les réservations",
        "description": "Liste toutes les réservations avec filtrage optionnel par statut et/ou membre.",
        "operationId": "listReservations",
        "parameters": [
          {
            "name": "statut",
            "in": "query",
            "description": "Filtrer par statut",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "EN_ATTENTE",
                "DISPONIBLE",
                "ANNULEE",
                "EXPIREE",
                "HONOREE"
              ]
            }
          },
          {
            "name": "adherentId",
            "in": "query",
            "description": "Filtrer par identifiant du membre",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste retournée avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Reservation"
        ],
        "summary": "Créer une réservation",
        "description": "Crée une nouvelle réservation pour un livre indisponible. Le serveur définit automatiquement les dates et le statut.",
        "operationId": "createReservation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "livreId ou adherentId manquant"
          },
          "201": {
            "description": "Réservation créée avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "409": {
            "description": "Règle métier violée (RG-01, RG-02, RG-03)"
          },
          "404": {
            "description": "Livre ou utilisateur introuvable"
          }
        }
      }
    },
