    "/api/reservations/{id}/annuler": {
      "patch": {
        "tags": [
          "Reservation"
        ],
        "summary": "Annuler une réservation",
        "description": "Annule une réservation. Seules les réservations EN_ATTENTE ou DISPONIBLE peuvent être annulées.",
        "operationId": "cancelReservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant de la réservation",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Réservation introuvable"
          },
          "200": {
            "description": "Réservation annulée avec succès",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "409": {
            "description": "Statut non annulable (RG-05)"
          }
        }
      }
    },
