          },
          "adherentId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ReservationResponse": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "integer",
            "format": "int32"
          },
          "livreId": {
            "type": "integer",
            "format": "int32"
          },
          "livreName": {
            "type": "string"
          },
          "adherentId": {
            "type": "integer",
            "format": "int32"
          },
          "adherentName": {
            "type": "string"
          },
          "dateReservation": {
            "type": "string",
            "format": "date-time"
          },
          "dateExpiration": {
            "type": "string",
            "format": "date-time"
          },
          "statut": {
            "type": "string",
            "enum": [
              "EN_ATTENTE",
              "DISPONIBLE",
              "ANNULEE",
              "EXPIREE",
              "HONOREE"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
