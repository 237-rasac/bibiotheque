          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          }
        }
      },
      "Books": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int32"
          },
          "bookName": {
            "type": "string"
          },
          "bookAuthor": {
            "type": "string"
          },
          "bookGenre": {
            "type": "string"
          },
          "noOfCopies": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "JwtRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "userPassword": {
            "type": "string",
            "writeOnly": true
          },
          "userName": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "JwtResponse": {
        "type": "object",
